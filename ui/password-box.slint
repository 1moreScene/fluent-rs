import { FluentPointerArea } from "interaction.slint";
import { FluentIcon, FluentText } from "primitives.slint";
import { TextBox, TextBoxActionSurface, TextBoxState } from "text-box.slint";
import { FluentMetrics, FluentTheme } from "tokens.slint";

export enum PasswordRevealMode { peek, hidden, visible }

export component PasswordRevealSurface inherits TextBoxActionSurface {
    FluentIcon {
        x: (root.action-content-width - self.width) / 2;
        y: (root.action-content-height - self.height) / 2;
        width: FluentMetrics.text-box-clear-icon-size;
        height: self.width;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 0.75 6 C 2 3.5 3.75 2.5 6 2.5 C 8.25 2.5 10 3.5 11.25 6 C 10 8.5 8.25 9.5 6 9.5 C 3.75 9.5 2 8.5 0.75 6 Z M 7.75 6 C 7.75 6.97 6.97 7.75 6 7.75 C 5.03 7.75 4.25 6.97 4.25 6 C 4.25 5.03 5.03 4.25 6 4.25 C 6.97 4.25 7.75 5.03 7.75 6 Z";
        stroke: FluentTheme.high-contrast && root.hovered ? FluentTheme.contrast-highlight-text
            : root.pressed ? FluentTheme.text-tertiary : FluentTheme.text-secondary;
        stroke-line-join: round;
    }
}

export component PasswordBox inherits FocusScope {
    in-out property <string> password <=> editor.text;
    in property <string> header;
    in property <string> placeholder-text;
    in property <string> accessible-name: root.header == "" ? root.placeholder-text : root.header;
    in property <PasswordRevealMode> reveal-mode;
    in property <bool> active: true;
    in property <length> minimum-target;
    out property <bool> editor-focused: editor.has-focus;
    out property <bool> has-selection: editor.has-selection;
    out property <length> horizontal-scroll-offset: editor.horizontal-scroll-offset;
    out property <TextBoxState> state: editor.state;
    out property <bool> reveal-button-visible: root.enabled && root.active && root.reveal-mode == PasswordRevealMode.peek
        && root.eligible && editor.has-focus && root.password != ""
        && editor.width > FluentMetrics.text-box-clear-min-width-em * FluentMetrics.scaled-font-size;
    out property <bool> revealed: root.reveal-mode == PasswordRevealMode.visible
        || (root.reveal-button-visible && (peek.pressed-inside || root.shortcut-peek || root.accessible-peek));
    out property <Point> input-position: editor.absolute-position;
    out property <length> input-width: editor.width;
    out property <length> input-height: editor.height;
    out property <Point> reveal-center: { x: peek.absolute-position.x + peek.width / 2, y: peek.absolute-position.y + peek.height / 2 };
    callback password-changed;
    callback accepted;

    property <string> last-password;
    property <bool> eligible;
    property <bool> shortcut-peek;
    property <bool> accessible-peek;

    min-width: FluentMetrics.text-box-min-width;
    min-height: layout.min-height;
    preferred-height: layout.preferred-height;
    vertical-stretch: 0;
    forward-focus: editor;
    focus-on-click: false;
    focus-on-tab-navigation: false;

    public function select-all() { editor.select-all(); }
    public function set-selection-offsets(anchor: int, cursor: int) { editor.set-selection-offsets(anchor, cursor); }

    function notify-change() {
        if (root.password != root.last-password) {
            root.last-password = root.password;
            root.password-changed();
        }
    }
    changed password => {
        if (root.password != root.last-password) {
            root.eligible = false;
            root.shortcut-peek = false;
            root.accessible-peek = false;
            root.notify-change();
        }
    }
    changed editor-focused => {
        root.eligible = false;
        root.shortcut-peek = false;
        root.accessible-peek = false;
    }
    changed reveal-mode => { root.shortcut-peek = false; root.accessible-peek = false; }
    capture-key-pressed(event) => {
        if (event.text == Key.F8 && event.modifiers.alt && root.reveal-button-visible) {
            root.shortcut-peek = true;
            return accept;
        }
        return reject;
    }
    capture-key-released(event) => {
        if (event.text == Key.F8) {
            root.shortcut-peek = false;
            return accept;
        }
        return reject;
    }

    layout := VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: FluentMetrics.spacing-medium;
        if root.header != "" : FluentText {
            text: root.header;
            color: root.enabled ? FluentTheme.text-primary : FluentTheme.text-disabled;
            wrap: word-wrap;
            accessible-role: none;
        }
        Rectangle {
            min-height: editor.min-height;
            preferred-height: self.min-height;
            vertical-stretch: 0;
            editor := TextBox {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                enabled: root.enabled && root.active;
                placeholder-text: root.placeholder-text;
                accessible-name: root.accessible-name;
                minimum-target: root.minimum-target;
                show-clear-button: false;
                sensitive-input: true;
                input-type: root.revealed ? InputType.text : InputType.password;
                editor-font-family: root.revealed ? "" : FluentTheme.password-mask-font-family;
                editor-measure-font-family: "";
                trailing-inset: FluentMetrics.text-box-padding-right + FluentMetrics.control-stroke
                    + (root.reveal-button-visible ? self.height : 0px);
                edited(value) => {
                    if (root.last-password == "" && value != "") { root.eligible = true; }
                    if (value == "") { root.eligible = false; }
                    root.accessible-peek = false;
                    root.notify-change();
                }
                accepted(value) => { root.accepted(); }
            }
            peek := FluentPointerArea {
                x: parent.width - self.width;
                y: 0px;
                width: parent.height;
                height: 100%;
                visible: root.reveal-button-visible;
                enabled: root.reveal-button-visible;
                accessible-role: button;
                accessible-label: @tr("Reveal password");
                accessible-checkable: true;
                accessible-checked: root.revealed;
                accessible-action-default => { root.accessible-peek = !root.accessible-peek; }
                PasswordRevealSurface {
                    width: 100%;
                    height: 100%;
                    hovered: peek.pointer-inside;
                    pressed: peek.pressed-inside;
                }
            }
        }
    }
}
