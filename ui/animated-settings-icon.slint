import { AnimatedIcon } from "animated-icon.slint";
import { FluentSystemIcon } from "fluent-system-icon.slint";
import { FluentMetrics } from "tokens.slint";

export component AnimatedSettingsIcon inherits AnimatedIcon {
    in property <bool> hovered;
    in property <bool> pressed;

    width: FluentMetrics.navigation-icon-size;
    height: self.width;
    state: root.pressed ? "Pressed" : root.hovered ? "PointerOver" : "Normal";
    source-duration: 2000ms;
    markers: [
        { name: "NormalToPointerOver_Start", progress: 0 },
        { name: "NormalToPointerOver_End", progress: 9.05 / 120 },
        { name: "NormalToPressed_Start", progress: 10.05 / 120 },
        { name: "NormalToPressed_End", progress: 19.05 / 120 },
        { name: "PointerOverToNormal_Start", progress: 20.05 / 120 },
        { name: "PointerOverToNormal_End", progress: 29.05 / 120 },
        { name: "PointerOverToPressed_Start", progress: 30.05 / 120 },
        { name: "PointerOverToPressed_End", progress: 39.05 / 120 },
        { name: "PressedToNormal_Start", progress: 40.05 / 120 },
        { name: "PressedToNormal_End", progress: 79.05 / 120 },
        { name: "PressedToPointerOver_Start", progress: 80.05 / 120 },
        { name: "PressedToPointerOver_End", progress: 119.05 / 120 },
    ];
    fallback-icon: @image-url("icons/fluent/settings-20-regular.svg");

    // The Windows asset holds still on hover, rotates 20° on press and spins on release.
    // For cubic-bezier(0, 0, 0, 1), the parameter is the cube root of time.
    pure function release-rotation(frame: float) -> angle {
        let t = pow(clamp(frame / 39, 0, 1), 1 / 3);
        return (-20 + 380 * t * t * (3 - 2 * t)) * 1deg;
    }

    property <float> frame: root.progress * 120;
    property <angle> rotation: root.frame >= 80 ? root.release-rotation(root.frame - 80)
        : root.frame >= 40 ? root.release-rotation(root.frame - 40)
        : root.frame >= 30 ? -20deg * clamp((root.frame - 30) / 9, 0, 1)
        : root.frame >= 20 ? 0deg
        : -20deg * clamp((root.frame - 10) / 9, 0, 1);

    if root.source-available : FluentSystemIcon {
        width: 100%;
        height: 100%;
        source: @image-url("icons/fluent/settings-animated.svg");
        foreground: root.foreground;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: root.rotation;
    }
}
