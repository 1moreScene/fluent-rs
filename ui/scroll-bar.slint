import { FluentPointerArea } from "interaction.slint";
import { FluentMotion } from "motion.slint";
import { FluentIcon } from "primitives.slint";
import { FluentMetrics, FluentTheme } from "tokens.slint";

component ScrollArrow inherits FluentIcon {
    in property <bool> decrease;
    in property <bool> horizontal;
    in property <bool> hovered;
    in property <bool> pressed;
    width: FluentMetrics.scroll-bar-arrow-size * (root.pressed ? 0.875 : 1.);
    height: self.width;
    viewbox-width: 8;
    viewbox-height: 8;
    commands: root.horizontal ? (root.decrease ? "M 5 1 L 2 4 L 5 7" : "M 3 1 L 6 4 L 3 7")
        : (root.decrease ? "M 1 5 L 4 2 L 7 5" : "M 1 3 L 4 6 L 7 3");
    stroke: FluentTheme.high-contrast
        ? (root.hovered || root.pressed ? FluentTheme.contrast-highlight : FluentTheme.contrast-text)
        : root.hovered || root.pressed ? FluentTheme.text-secondary : FluentTheme.control-strong-fill;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// Reads the viewport's actual offset. Input only requests an offset so that
// Slint's Flickable or virtual list remains the owner of the scrolling state.
export component FluentScrollBar inherits Rectangle {
    in property <length> extent;
    in property <length> viewport-size;
    in property <length> offset;
    in property <length> line-step: FluentMetrics.scaled-font-size;
    in property <bool> horizontal;
    in property <string> accessible-name: root.horizontal ? @tr("Horizontal scroll bar") : @tr("Vertical scroll bar");
    in property <bool> enabled: true;
    in property <bool> handles-wheel;
    out property <length> maximum: max(0px, root.extent - root.viewport-size);
    callback offset-requested(length);

    width: FluentMetrics.scroll-bar-size;
    visible: root.maximum > 0px && root.viewport-size > 0px && root.axis-length > 0px;
    accessible-role: slider;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-orientation: root.horizontal ? Orientation.horizontal : Orientation.vertical;
    accessible-value: clamp(root.offset, 0px, root.maximum) / 1px;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.maximum / 1px;
    accessible-value-step: root.line-step / 1px;
    accessible-action-set-value(value) => {
        if (value.is-float()) { root.request(value.to-float() * 1px); }
    }

    property <bool> touch-indicator;
    property <bool> want-expanded: !root.touch-indicator && (hit.pointer-inside || root.dragging);
    property <bool> delayed-expanded;
    property <bool> expanded: root.enabled && !root.touch-indicator && (FluentTheme.high-contrast
        || (FluentMotion.enabled ? root.delayed-expanded : root.want-expanded));
    property <length> axis-length: root.horizontal ? root.width : root.height;
    property <length> breadth: root.horizontal ? root.height : root.width;
    property <length> arrow-zone: min(root.breadth, root.axis-length / 4);
    // Collapsed and expanded mouse indicators share one track. The touch
    // panning indicator is the one that uses the full height.
    property <length> track-inset: root.touch-indicator ? 0px : root.arrow-zone;
    property <length> track-size: max(0px, root.axis-length - 2 * root.track-inset);
    property <length> minimum-thumb-size: root.touch-indicator
        ? FluentMetrics.scroll-bar-panning-thumb-min-height : FluentMetrics.scroll-bar-thumb-min-height;
    property <length> thumb-size: min(root.track-size, max(root.minimum-thumb-size,
        root.track-size * root.viewport-size / max(1px, root.extent)));
    property <length> travel: root.track-size - root.thumb-size;
    property <length> thumb-top: root.track-inset
        + root.travel * clamp(root.offset / max(1px, root.maximum), 0, 1);
    property <length> mouse-thumb-width: max(0px,
        (root.expanded ? root.breadth : FluentMetrics.scroll-bar-collapsed-thumb-width)
        - FluentMetrics.scroll-bar-thumb-stroke);
    property <length> drag-offset;
    property <bool> dragging;
    property <length> pointer-position: root.horizontal ? hit.mouse-x : hit.mouse-y;
    property <bool> over-decrease: hit.pointer-inside && root.pointer-position < root.arrow-zone;
    property <bool> over-increase: hit.pointer-inside && root.pointer-position >= root.axis-length - root.arrow-zone;

    changed want-expanded => {
        transition.stop();
        if (FluentMotion.enabled) { transition.start(); }
        else { root.delayed-expanded = root.want-expanded; }
    }
    transition := Timer {
        interval: root.want-expanded ? FluentMotion.scroll-bar-expand-delay : FluentMotion.scroll-bar-contract-delay;
        running: false;
        triggered => {
            self.stop();
            root.delayed-expanded = root.want-expanded;
        }
    }

    function request(next: length) {
        if (root.enabled) { root.offset-requested(clamp(next, 0px, root.maximum)); }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 2 * FluentMetrics.scroll-bar-radius;
        // Composite the acrylic tint without resampling scrolling content.
        background: FluentTheme.high-contrast ? FluentTheme.contrast-surface
            : FluentTheme.reduce-transparency ? FluentTheme.acrylic-fallback : FluentTheme.acrylic-in-app-tint;
        border-width: FluentTheme.high-contrast ? FluentMetrics.control-stroke : 0px;
        border-color: FluentTheme.contrast-text;
        opacity: root.expanded ? 1 : 0;
        animate opacity { duration: FluentMotion.enabled ? FluentMotion.scroll-bar-fade : 0ms; }
    }

    Rectangle {
        property <length> thickness: root.touch-indicator ? FluentMetrics.scroll-bar-panning-thumb-width : root.mouse-thumb-width;
        property <length> cross: root.touch-indicator ? root.breadth - self.thickness - FluentMetrics.scroll-bar-panning-inset
            : (root.breadth - root.mouse-thumb-width) / 2 + (root.expanded ? 0px : FluentMetrics.scroll-bar-collapsed-thumb-offset);
        property <length> along: root.thumb-top + (root.touch-indicator ? 0px : FluentMetrics.scroll-bar-thumb-stroke / 2);
        property <length> span: max(0px, root.thumb-size - (root.touch-indicator ? 0px : FluentMetrics.scroll-bar-thumb-stroke));
        x: root.horizontal ? self.along : self.cross;
        y: root.horizontal ? self.cross : self.along;
        width: root.horizontal ? self.span : self.thickness;
        height: root.horizontal ? self.thickness : self.span;
        border-radius: min(self.thickness / 2, FluentMetrics.scroll-bar-radius);
        background: !root.enabled ? FluentTheme.control-strong-fill-disabled
            : FluentTheme.high-contrast ? (root.dragging || (root.expanded && hit.pointer-inside
                && root.pointer-position >= root.thumb-top && root.pointer-position < root.thumb-top + root.thumb-size)
                ? FluentTheme.contrast-highlight : FluentTheme.contrast-disabled) : FluentTheme.control-strong-fill;
        animate thickness, cross {
            duration: FluentMotion.enabled && !root.touch-indicator ? FluentMotion.scroll-bar-resize : 0ms;
            easing: FluentMotion.control-fast-out-slow-in;
        }
    }

    for at-start in [true, false] : ScrollArrow {
        property <length> along: at-start ? (root.arrow-zone - self.height + FluentMetrics.scroll-bar-arrow-inset) / 2
            : root.axis-length - (root.arrow-zone + self.height + FluentMetrics.scroll-bar-arrow-inset) / 2;
        property <length> cross: (root.breadth - self.width) / 2;
        x: root.horizontal ? self.along : self.cross;
        y: root.horizontal ? self.cross : self.along;
        horizontal: root.horizontal;
        decrease: at-start;
        hovered: at-start ? root.over-decrease : root.over-increase;
        pressed: self.hovered && hit.pressed && !root.dragging;
        visible: root.arrow-zone >= self.height;
        opacity: root.expanded ? 1 : 0;
        animate opacity { duration: FluentMotion.enabled ? FluentMotion.scroll-bar-fade : 0ms; }
    }

    hit := FluentPointerArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        interaction-event(event) => {
            if (!root.dragging && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move)) {
                root.touch-indicator = event.touch-finger-id != 0;
            }
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                let position = root.pointer-position;
                if (position >= root.thumb-top && position < root.thumb-top + root.thumb-size) {
                    root.drag-offset = position - root.thumb-top;
                    root.dragging = true;
                }
                else if (root.expanded && position < root.arrow-zone) { root.request(root.offset - root.line-step); }
                else if (root.expanded && position >= root.axis-length - root.arrow-zone) { root.request(root.offset + root.line-step); }
                else { root.request(root.offset + (position < root.thumb-top ? -root.viewport-size : root.viewport-size)); }
            } else if (event.kind == PointerEventKind.move && root.dragging && root.travel > 0px) {
                root.request(root.maximum * (root.pointer-position - root.track-inset - root.drag-offset) / root.travel);
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.dragging = false;
            }
        }
        scroll-event(event) => {
            if (!root.handles-wheel) { return reject; }
            let delta = root.horizontal && event.delta-x != 0px ? event.delta-x : event.delta-y;
            let target = clamp(root.offset - delta, 0px, root.maximum);
            if (target == root.offset) { return reject; }
            root.request(target);
            return accept;
        }
    }
}
