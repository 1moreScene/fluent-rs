export global FluentTheme {
    // Official SystemThemingInterop's stable override ramp; hosts may supply UISettings values.
    in property <color> accent-dark1: #005a9e;
    in property <color> accent-dark2: #004275;
    in property <color> accent-dark3: #002642;
    in property <color> accent-light2: #76b9ed;
    in property <color> accent-light3: #a6d8ff;
    in property <bool> hyperlink-underline-visible: false;
    out property <color> accent-foreground: dark ? accent-light3 : accent-dark2;
    out property <color> accent-foreground-hover: dark ? accent-light3 : accent-dark3;
    out property <color> accent-foreground-pressed: dark ? accent-light2 : accent-dark1;
    out property <color> accent-foreground-disabled: dark ? #ffffff5d : #0000005c;
    in property <string> password-mask-font-family;
    in-out property <FluentColorScheme> scheme: FluentColorScheme.light;
    in property <color> light-accent: #005fb8;
    in property <color> dark-accent: #60cdff;
    in property <bool> reduced-motion: false;
    in property <bool> reduce-transparency: false;
    in property <color> system-accent: #0078d4;
    in property <float> text-scale: 1;
    in property <float> ui-scale: 1;

    // Hosts can supply an operating system's contrast palette.
    in property <color> contrast-surface: #000000;
    in property <color> contrast-text: #ffffff;
    in property <color> contrast-disabled: #a6a6a6;
    in property <color> contrast-highlight: #ffff00;
    in property <color> contrast-highlight-text: #000000;
    in property <color> contrast-hotlight: contrast-highlight;
    in property <color> contrast-button-face: contrast-surface;
    in property <color> contrast-button-text: contrast-text;

    out property <bool> dark: scheme == FluentColorScheme.dark;
    out property <bool> high-contrast: scheme == FluentColorScheme.high-contrast;
    out property <color> page: high-contrast ? contrast-surface : dark ? #202020 : #f3f3f3;
    out property <color> page-alt: high-contrast ? contrast-surface : dark ? #0a0a0a : #dadada;
    out property <color> card-fill: high-contrast ? contrast-surface : dark ? #ffffff0d : #ffffffb3;
    out property <color> card-fill-secondary: high-contrast ? contrast-surface : dark ? #ffffff08 : #f6f6f680;
    out property <color> card-stroke: high-contrast ? contrast-text : dark ? #00000019 : #0000000f;
    out property <color> navigation-content-fill: high-contrast ? contrast-surface : dark ? #3a3a3a4c : #ffffff80;
