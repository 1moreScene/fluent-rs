    public pure function menu-row-height(minimum-target: length) -> length {
        return max(minimum-target, scaled-font-size + (minimum-target > 0px ? 26px : 18px) * FluentTheme.ui-scale);
    }

    public pure function menu-content-width(label-width: length, icons: bool, minimum-target: length) -> length {
        let label-and-padding = label-width + 2 * (spacing-small + button-padding-horizontal);
        return 2 * flyout-border-width + max(minimum-target > 0px ? menu-touch-min-width : flyout-min-width,
            label-and-padding + (icons ? menu-icon-column : 0px));
    }

    public pure function menu-height(item-count: int, minimum-target: length) -> length {
        return min(flyout-max-height, item-count * menu-row-height(minimum-target) + 2 * menu-presenter-inset);
    }

    public pure function list-row-height(minimum-target: length) -> length {
        return max(minimum-target, list-row-min-height, scaled-font-size + 2 * spacing-medium);
