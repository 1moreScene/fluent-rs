import { ButtonState } from "interaction.slint";
import { FluentMotion } from "motion.slint";
import { FluentFocusRing, FluentIcon, FluentSurface, FluentText } from "primitives.slint";
import { FluentToggle, ToggleValue } from "toggle.slint";
import { FluentMetrics, FluentTheme } from "tokens.slint";
export { ToggleValue }

component CheckMark inherits FluentIcon {
    in property <bool> checked;
    in property <bool> pressed;
    in property <bool> motion-enabled;
    property <float> progress: checked ? 1 : 0;
    property <float> start: checked ? 0 : 1 - progress;
    property <float> end: checked ? progress : 1;

    animate progress {
        enabled: root.motion-enabled;
        duration: !root.checked ? FluentMotion.check-mark-exit
            : root.pressed ? FluentMotion.check-mark-enter-pressed : FluentMotion.check-mark-enter;
        easing: root.checked ? FluentMotion.check-mark-enter-easing : linear;
    }

    // Both segments are at 45 degrees, so horizontal progress is also path-length progress.
    pure function mark-y(progress: float) -> float {
        return 9 - abs(9 * progress - 3);
    }
    viewbox-width: 12;
    viewbox-height: 12;
    stroke-width: progress > 0 ? FluentMetrics.check-box-glyph-stroke : 0px;
    stroke-line-cap: round;
    stroke-line-join: round;

    MoveTo { x: 1.5 + 9 * root.start; y: root.mark-y(root.start); }
    LineTo {
        property <float> corner: clamp(1 / 3, root.start, root.end);
        x: 1.5 + 9 * corner;
        y: root.mark-y(corner);
    }
    LineTo { x: 1.5 + 9 * root.end; y: root.mark-y(root.end); }
}

export component CheckBoxSurface {
    in property <string> text;
    in property <ToggleValue> value;
    in property <ButtonState> state;
    in property <bool> focus-visible;
    in property <length> minimum-target;
    property <bool> selected: value != ToggleValue.unchecked;
    property <bool> mixed: value == ToggleValue.indeterminate;
    property <bool> disabled: state == ButtonState.disabled;
    property <bool> pressed: state == ButtonState.pressed;
    property <bool> hovered: state == ButtonState.pointer-over;
    property <length> glyph-size: FluentMetrics.check-box-glyph-size;

    min-width: max(FluentMetrics.check-box-min-width, minimum-target, content.min-width);
    preferred-width: max(self.min-width, content.preferred-width);
    min-height: max(FluentMetrics.check-box-min-height, minimum-target);

    pure function box-fill() -> color {
        if (FluentTheme.high-contrast) {
            if (disabled) { return selected ? FluentTheme.contrast-disabled : FluentTheme.contrast-surface; }
            if (mixed) { return hovered ? FluentTheme.contrast-highlight-text : FluentTheme.contrast-highlight; }
            if (selected) { return pressed ? FluentTheme.contrast-button-face
                : hovered ? FluentTheme.contrast-button-text : FluentTheme.contrast-highlight; }
            return pressed ? FluentTheme.contrast-highlight
                : hovered ? FluentTheme.contrast-highlight-text : FluentTheme.contrast-button-face;
        }
        if (selected) {
            return disabled ? FluentTheme.accent-fill-disabled : pressed ? FluentTheme.accent-fill-pressed
                : hovered ? FluentTheme.accent-fill-hover : FluentTheme.accent-fill;
        }
        return disabled ? transparent : pressed ? FluentTheme.control-alt-fill-pressed
            : hovered ? FluentTheme.control-alt-fill-hover : FluentTheme.control-alt-fill;
    }

    pure function box-stroke() -> color {
        if (FluentTheme.high-contrast) {
            if (disabled) { return FluentTheme.contrast-disabled; }
            if (selected) { return mixed ? FluentTheme.contrast-highlight : box-fill(); }
            return hovered || pressed ? FluentTheme.contrast-highlight : FluentTheme.contrast-button-text;
        }
        if (disabled || (!selected && pressed)) { return FluentTheme.control-strong-stroke-disabled; }
        return selected ? box-fill() : FluentTheme.control-strong-stroke;
    }

    pure function glyph-ink() -> color {
        if (FluentTheme.high-contrast) {
            if (disabled) { return FluentTheme.contrast-surface; }
            if (mixed) { return hovered ? FluentTheme.contrast-highlight : FluentTheme.contrast-highlight-text; }
            return pressed ? FluentTheme.contrast-button-text
                : hovered ? FluentTheme.contrast-button-face : FluentTheme.contrast-highlight-text;
        }
        return disabled ? FluentTheme.accent-text-disabled
            : pressed ? FluentTheme.accent-text-pressed : FluentTheme.accent-text;
    }

    content := HorizontalLayout {
        spacing: root.text == "" ? 0px : FluentMetrics.check-box-label-gap;
        alignment: start;

        Rectangle {
            width: FluentMetrics.check-box-size;
            min-height: FluentMetrics.check-box-size;
            FluentSurface {
                y: (parent.height - self.height) / 2;
                width: FluentMetrics.check-box-size;
                height: self.width;
                background: root.box-fill();
                border-color: root.box-stroke();

                CheckMark {
                    x: (parent.width - root.glyph-size) / 2;
                    y: (parent.height - root.glyph-size) / 2 + FluentMetrics.check-box-glyph-offset;
                    width: root.glyph-size;
                    height: root.glyph-size;
                    checked: root.value == ToggleValue.checked;
                    pressed: root.pressed;
                    motion-enabled: FluentMotion.enabled && !root.mixed && !root.disabled;
                    stroke: root.glyph-ink();
                }

                if root.mixed : FluentIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2 + FluentMetrics.check-box-glyph-offset;
                    width: root.glyph-size;
                    height: self.width;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    commands: "M 2 6 L 10 6";
                    stroke: root.glyph-ink();
                    stroke-width: FluentMetrics.check-box-glyph-stroke;
                    stroke-line-cap: round;
                }
            }
        }

        if root.text != "" : VerticalLayout {
            padding-top: FluentMetrics.check-box-label-top;
            alignment: start;
            horizontal-stretch: 1;
            FluentText {
                text: root.text;
                color: root.disabled ? FluentTheme.text-disabled : FluentTheme.high-contrast && !root.mixed
                    ? FluentTheme.contrast-button-text : FluentTheme.text-primary;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
    }

    if root.focus-visible && !root.disabled : FluentFocusRing {
        width: 100%;
        height: 100%;
        horizontal-outset: FluentMetrics.check-box-focus-outset;
    }
}

export component CheckBox inherits FluentToggle {
    in property <string> text;
    in property <length> minimum-target;

    min-width: surface.min-width;
    min-height: surface.min-height;
    preferred-width: surface.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    accessible-role: checkbox;
    accessible-label: text;

    surface := CheckBoxSurface {
        width: 100%;
        height: 100%;
        text: root.text;
        value: root.value;
        state: root.state;
        focus-visible: root.focus-visible;
        minimum-target: root.minimum-target;
    }
}
