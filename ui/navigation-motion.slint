import { FluentMotion } from "motion.slint";

export global NavigationMotion {
    public pure function enter(progress: float) -> float {
        return sample(progress, 0.1, 0.9, 0.2, 1);
    }

    public pure function exit(progress: float) -> float {
        return sample(progress, 0.7, 0, 1, 0.5);
    }

    public pure function stretch(progress: float) -> float {
        return sample(progress, 0.9, 0.1, 1, 0.2);
    }

    // Invert the time axis of WinUI's cubic splines before evaluating their value.
    pure function curve(t: float, a: float, b: float) -> float {
        return t * (3 * (1 - t) * ((1 - t) * a + t * b) + t * t);
    }

    pure function bisect(x: float, t: float, step: float, a: float, b: float) -> float {
        return curve(t, a, b) < x ? t + step : t - step;
    }

    pure function sample(x: float, x1: float, y1: float, x2: float, y2: float) -> float {
        if (x <= 0 || x >= 1) { return clamp(x, 0, 1); }
        let a = bisect(x, 0.5, 0.25, x1, x2);
        let b = bisect(x, a, 0.125, x1, x2);
        let c = bisect(x, b, 0.0625, x1, x2);
        let d = bisect(x, c, 0.03125, x1, x2);
        let e = bisect(x, d, 0.015625, x1, x2);
        let f = bisect(x, e, 0.0078125, x1, x2);
        let g = bisect(x, f, 0.00390625, x1, x2);
        return curve(bisect(x, g, 0.001953125, x1, x2), y1, y2);
    }
}

export component NavigationClock {
    in property <duration> interval;
    out property <bool> running: timer.running && FluentMotion.enabled;
    out property <duration> elapsed: root.running ? clamp(animation-tick() - root.start-time, 0ms, root.interval) : root.interval;
    property <duration> start-time;
    public function start() {
        timer.stop();
        if (FluentMotion.enabled) {
            root.start-time = animation-tick();
            timer.start();
        }
    }

    changed running => {
        if (!FluentMotion.enabled && timer.running) {
            timer.stop();
        }
    }

    timer := Timer {
        interval: root.interval;
        running: false;
        triggered => { self.stop(); }
    }
}

export component NavigationPaneMotion {
    in property <bool> expanded;
    in property <bool> animate-changes;
    in property <bool> overlay;
    out property <float> progress: root.expanded ? 1 : 0;

    animate progress {
        enabled: root.animate-changes && FluentMotion.enabled;
        duration: !root.overlay ? FluentMotion.navigation-inline
            : root.expanded ? FluentMotion.navigation-drawer-enter : FluentMotion.navigation-drawer-exit;
        easing: root.overlay ? FluentMotion.navigation-drawer-easing : FluentMotion.navigation-inline-easing;
    }
}

export component NavigationIndicatorMotion {
    in property <int> index: -1;
    in property <length> step;
    in property <length> pill-height;
    in property <length> position: root.index * root.step;
    out property <length> top: min(root.from, root.to);
    out property <length> extent: abs(root.to - root.from) + root.pill-height;
    out property <bool> has-indicator: root.index >= 0;

    property <int> previous: -1;
    property <int> origin: -1;
    property <length> previous-position;
    property <length> start;
    property <length> end: root.position;
    property <duration> time: clock.elapsed;
    property <bool> extending: root.time < FluentMotion.navigation-indicator-stretch;
    property <float> reach: NavigationMotion.stretch(root.time / FluentMotion.navigation-indicator-stretch);
    property <float> contract: NavigationMotion.enter((root.time - FluentMotion.navigation-indicator-stretch) / FluentMotion.navigation-indicator-contract);
    property <length> from: !clock.running || root.origin < 0 ? root.end
        : root.extending ? root.start : root.start + (root.end - root.start) * root.contract;
    property <length> to: !clock.running || root.origin < 0 || !root.extending ? root.end
        : root.start + (root.end - root.start) * root.reach;

    init => { root.previous-position = root.position; root.previous = root.index; }
    changed position => {
        if (root.index == root.previous) { root.previous-position = root.position; }
    }
    changed index => {
        root.origin = root.previous;
        root.start = root.previous-position;
        root.previous = root.index;
        root.previous-position = root.position;
        if (root.origin >= 0 && root.index >= 0 && root.start != root.position) { clock.start(); }
    }

    clock := NavigationClock {
        interval: FluentMotion.navigation-indicator-stretch + FluentMotion.navigation-indicator-contract;
    }
}
