export enum GalleryPage { button, text-box, foundations, toggles, radios, ranges, composition, combo-box, overlays, content-dialog, info-bar, navigation-view, auto-suggest-box, tree-view, command-bar, password-box, toggle-switch, expander, split-button, repeat-button, hyperlink-button, drop-down-button, toggle-split-button, grid-view, number-box, person-picture, selector-bar, pips-pager }

export struct GalleryDestination {
    title: string,
    label: string,
    page: GalleryPage,
}

export global GalleryRoutes {
    pure callback index([GalleryDestination], GalleryPage) -> int;
}

export struct GalleryNavigationProbe {
    selected: int,
    items: Point,
    footer: Point,
    item-step: length,
    pane-width: length,
    pane-open: bool,
    mode: NavigationDisplayMode,
    toggle: Point,
    expanded-items: [int],
}

export component GalleryWindow inherits Window {
    title: "Fluent RS Gallery";
    preferred-width: 720px;
    preferred-height: 620px;
    default-font-family: root.font-family;
    default-font-size: FluentMetrics.scaled-font-size;
    background: root.native-desktop-acrylic && !FluentTheme.high-contrast
        ? (root.tint-native-desktop-acrylic ? FluentTheme.desktop-acrylic-tint : transparent)
        : FluentMaterials.fallback-color(root.backdrop);

    in property <bool> touch-targets;
    out property <length> gallery-body-size: FluentMetrics.scaled-font-size;
    out property <length> gallery-control-height: FluentMetrics.combo-min-height;
    in property <string> font-family;
    in-out property <GalleryPage> page;
    out property <SelectorBarProbe> selector-bar-probe: selectors.probe;
    public function focus-selector-clear() { selectors.focus-clear(); }
    public function select-selector-item(index: int) { selectors.select-item(index); }
    out property <PipsPagerProbe> pips-pager-probe: pips.probe;
    in-out property <int> pips-index <=> pips.page-index;
    in-out property <int> pips-count <=> pips.page-count;
    in-out property <bool> pips-vertical <=> pips.vertical;
    in-out property <bool> pips-wrap <=> pips.wrap-pages;
    in-out property <bool> pips-enabled <=> pips.pager-enabled;
    in-out property <PipsPagerButtonVisibility> pips-arrows <=> pips.arrow-mode;
