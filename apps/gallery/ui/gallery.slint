    in-out property <[ItemData]> suggestion-items <=> suggestions.items;
    in-out property <string> suggestion-text <=> suggestions.text;
    in-out property <bool> suggestion-enabled <=> suggestions.input-enabled;
    in-out property <bool> suggestion-query-icon <=> suggestions.query-icon;
