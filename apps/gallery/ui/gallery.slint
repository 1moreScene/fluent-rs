    in-out property <bool> list-format-checked <=> toggle-split-buttons.checked;
    out property <DropDownProbe> drop-down-probe: drop-down-buttons.probe;
    out property <ToggleSplitProbe> toggle-split-probe: toggle-split-buttons.probe;
    in-out property <string> password <=> passwords.password;
