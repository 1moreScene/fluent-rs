    in-out property <PasswordRevealMode> password-reveal-mode <=> passwords.reveal-mode;
    out property <PasswordProbe> password-probe: passwords.probe;
    out property <int> password-edits: passwords.edits;
    out property <int> password-submissions: passwords.submissions;
    out property <bool> password-following-focused: passwords.following-focused;
    public function select-password-input() { passwords.select-input(); }
    public function focus-password-input() { passwords.focus-input(); }
    public function leave-password-input() { passwords.leave-input(); }
    in-out property <bool> switch-on <=> switches.is-on;
    in-out property <bool> switch-enabled <=> switches.input-enabled;
    in-out property <bool> switch-long-label <=> switches.long-label;
    out property <SwitchProbe> switch-probe: switches.probe;
    out property <int> switch-toggles: switches.toggles;
