    in-out property <bool> grid-show-large <=> grids.show-large;
    in-out property <bool> grid-scroll-horizontally <=> grids.scroll-horizontally;
    in-out property <ListSelectionMode> grid-selection-mode <=> grids.selection-mode;
    out property <GridViewProbe> grid-probe: grids.probe;
    public function grid-scroll-to-index(index: int) { grids.scroll-to-index(index); }
    public function grid-select-index(index: int) { grids.set-selected-index(index); }

    in-out property <bool> repeat-enabled <=> repeat-buttons.button-enabled;
    in-out property <bool> repeat-disable-on-click <=> repeat-buttons.disable-on-click;
    in-out property <ButtonClickMode> repeat-click-mode <=> repeat-buttons.click-mode;
    in-out property <duration> repeat-delay <=> repeat-buttons.delay;
    in-out property <duration> repeat-interval <=> repeat-buttons.interval;
    out property <int> repeat-clicks: repeat-buttons.clicks;
    in-out property <string> number-value <=> numbers.value;
    in-out property <string> number-text <=> numbers.text;
    in-out property <string> number-minimum <=> numbers.minimum;
    in-out property <string> number-maximum <=> numbers.maximum;
    in-out property <string> number-small-change <=> numbers.small-change;
    in-out property <string> number-large-change <=> numbers.large-change;
    in-out property <bool> number-enabled <=> numbers.input-enabled;
    in-out property <bool> number-wrap <=> numbers.wrap;
    in-out property <bool> number-expression <=> numbers.accepts-expression;
    in-out property <NumberBoxSpinButtonPlacement> number-placement <=> numbers.placement;
    in-out property <NumberBoxValidationMode> number-validation <=> numbers.validation-mode;
    in-out property <string> number-decimal-separator <=> numbers.decimal-separator;
    in-out property <int> number-fraction-digits <=> numbers.minimum-fraction-digits;
    out property <int> number-changes:numbers.changes;
    out property <NumberProbe> number-probe:numbers.probe;
    out property <bool> number-following-focused:numbers.following-focused;
    public function focus-number-input() { numbers.focus-input(); }
    public function select-number-input() { numbers.select-input(); }
    public function leave-number-input() { numbers.leave-input(); }
    public function commit-number-input() { numbers.commit-input(); }
    in-out property <string> person-name <=> persons.display-name;
    in-out property <string> person-initials <=> persons.initials;
    in-out property <bool> person-photo <=> persons.photo;
    in-out property <bool> person-group <=> persons.group;
    in-out property <int> person-badge-number <=> persons.badge-number;
    in-out property <string> person-badge-glyph <=> persons.badge-glyph;
    in-out property <bool> person-badge-image <=> persons.badge-image;
    in-out property <float> person-size <=> persons.picture-size;
    out property <PersonProbe> person-probe:persons.probe;
    out property <bool> person-following-focused:persons.following-focused;
    public function focus-person-previous() { persons.focus-previous(); }
    callback repeat-clicked;
    out property <RepeatButtonProbe> repeat-probe: repeat-buttons.probe;
    public function focus-repeat() { repeat-buttons.focus-button(); }
    public function leave-repeat() { repeat-buttons.leave-button(); }
    in-out property <bool> hyperlink-enabled <=> hyperlinks.link-enabled;
    in-out property <bool> hyperlink-long-label <=> hyperlinks.long-label;
    in-out property <bool> hyperlink-suppress-uri <=> hyperlinks.suppress-uri;
    in-out property <string> hyperlink-uri <=> hyperlinks.navigate-uri;
    out property <int> hyperlink-clicks: hyperlinks.clicks;
    out property <int> hyperlink-requests: hyperlinks.navigation-requests;
    out property <string> hyperlink-status: hyperlinks.status;
    out property <HyperlinkProbe> hyperlink-probe: hyperlinks.probe;
    public function focus-hyperlink() { hyperlinks.focus-link(); }
    public function leave-hyperlink() { hyperlinks.leave-link(); }
    public function focus-local-hyperlink() { hyperlinks.focus-local-link(); }

    in property <bool> shell-pane-visible: true;
    in property <[ItemData]> shell-items;
    out property <GalleryNavigationProbe> shell-probe: {
        selected: shell.selected-index, items: shell.items-origin, footer: shell.footer-origin, item-step: shell.item-step,
        pane-width: shell.pane-width, pane-open: shell.pane-open, mode: shell.display-mode,
        toggle: shell.toggle-center, expanded-items: shell.expanded-items,
    };
    out property <[GalleryDestination]> destinations: [
        { title: "Button", page: GalleryPage.button },
        { title: "TextBox", page: GalleryPage.text-box },
        { title: "ToggleButton and CheckBox", label: "Toggles", page: GalleryPage.toggles },
        { title: "RadioButton and RadioGroup", label: "Radio", page: GalleryPage.radios },
        { title: "Slider and Progress", label: "Range", page: GalleryPage.ranges },
        { title: "ListBox", page: GalleryPage.composition },
        { title: "ComboBox", page: GalleryPage.combo-box },
        { label: "Overlays" },
        { title: "Overlays", label: "Flyout, Menu and Tooltip", page: GalleryPage.overlays },
        { title: "ContentDialog", page: GalleryPage.content-dialog },
        { title: "InfoBar", page: GalleryPage.info-bar },
        { title: "NavigationView", page: GalleryPage.navigation-view },
        { title: "TreeView", page: GalleryPage.tree-view },
        { title: "CommandBar", page: GalleryPage.command-bar },
        { title: "AutoSuggestBox", page: GalleryPage.auto-suggest-box },
        { title: "PasswordBox", page: GalleryPage.password-box },
        { title: "ToggleSwitch", page: GalleryPage.toggle-switch },
        { title: "Expander", page: GalleryPage.expander },
        { title: "SplitButton", page: GalleryPage.split-button },
        { title: "RepeatButton", page: GalleryPage.repeat-button },
        { title: "HyperlinkButton", page: GalleryPage.hyperlink-button },
        { title: "DropDownButton", page: GalleryPage.drop-down-button },
        { title: "ToggleSplitButton", page: GalleryPage.toggle-split-button },
        { title: "GridView", page: GalleryPage.grid-view },
        { title: "NumberBox", page: GalleryPage.number-box },
        { title: "PersonPicture", page: GalleryPage.person-picture },
        { title: "SelectorBar", page: GalleryPage.selector-bar },
        { title: "PipsPager", page: GalleryPage.pips-pager },
        { title: "Foundations", label: "Settings", page: GalleryPage.foundations },
    ];
    property <int> settings-destination: root.destinations.length - 1;
    property <int> selected-destination: root.shell-items.length > 0
        ? GalleryRoutes.index(root.destinations, root.page) : -1;
    changed selected-destination => { shell.set-selected-index(root.selected-destination); }

    property <OverlayArea> safe-viewport: {
        x: root.safe-area-insets.left, y: root.safe-area-insets.top,
        width: root.content-width,
        height: max(0px, root.height - root.safe-area-insets.top - root.safe-area-insets.bottom),
    };

    property <length> content-width: max(0px, root.width - root.safe-area-insets.left - root.safe-area-insets.right);
    property <bool> compact-window: root.content-width < FluentMetrics.compact-width;
    property <length> page-padding: root.compact-window ? FluentMetrics.spacing-large : FluentMetrics.spacing-page;
    property <length> target-size: touch-targets ? FluentMetrics.touch-target : 0px;

    FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            FluentFocus.keyboard-input = true;
            if (event.text == Key.Escape && (overlays.tip-open || overlays.tip-pending)) {
                overlays.dismiss-tip();
                return accept;
            }
            return reject;
        }
        shell := NavigationView {
            pane-title: "Fluent RS Gallery";
            pane-display-mode: auto;
            expanded-threshold: 900px;
            open-pane-width: 240px * FluentTheme.ui-scale;
            minimum-target: root.target-size;
            pane-visible: root.shell-pane-visible;
            viewport: root.safe-viewport;
            content-background: root.shell-pane-visible && root.backdrop == FluentMaterial.solid-fallback
                ? FluentTheme.navigation-content-fill : transparent;
            initial-selected-index: 0;
            items: root.shell-items;
            footer-start: root.settings-destination;
            item-details: [
                { index: 7, parent-index: -1, selects-on-invoked: false },
                { index: 8, parent-index: 7, selects-on-invoked: true },
                { index: 9, parent-index: 7, selects-on-invoked: true },
                { index: 11, parent-index: -1, selects-on-invoked: true,
                  has-badge: true, badge-value: navigation.notification-count },
                { index: root.settings-destination, parent-index: -1, selects-on-invoked: true, icon-kind: animated-settings },
            ];
            icons: [
                @image-url("../../../ui/icons/fluent/cursor-click-20-regular.svg"),
                @image-url("../../../ui/icons/fluent/window-20-regular.svg"),
                @image-url("../../../ui/icons/fluent/toggle-left-20-regular.svg"),
                @image-url("../../../ui/icons/fluent/radio-button-20-regular.svg"),
                @image-url("../../../ui/icons/fluent/options-20-regular.svg"),
                @image-url("../../../ui/icons/fluent/text-bullet-list-20-regular.svg"),
                @image-url("../../../ui/icons/fluent/chevron-down-12-regular.svg"),
                @image-url("../../../ui/icons/fluent/window-multiple-20-regular.svg"),
                @image-url(""),
                @image-url(""),
                @image-url("../../../ui/icons/fluent/info-20-regular.svg"),
                @image-url("../../../ui/icons/fluent/navigation-20-regular.svg"),
                @image-url("../../../ui/icons/fluent/folder-20-regular.svg"),
                @image-url("../../../ui/icons/fluent/more-horizontal-20-regular.svg"),
                @image-url("../../../ui/icons/fluent/text-bullet-list-20-regular.svg"),
                @image-url("../../../ui/icons/fluent/document-20-regular.svg"),
                @image-url("../../../ui/icons/fluent/toggle-left-20-regular.svg"),
                @image-url("../../../ui/icons/fluent/chevron-down-12-regular.svg"),
                @image-url("../../../ui/icons/fluent/cursor-click-20-regular.svg"),
                @image-url(""),
                @image-url(""),
                @image-url(""),
                @image-url(""),
                @image-url(""),
            ];
            selection-changed(index) => { root.page = root.destinations[index].page; }
            x: root.safe-area-insets.left;
            y: root.safe-area-insets.top;
            width: root.content-width;
            height: max(0px, parent.height - root.safe-area-insets.top - root.safe-area-insets.bottom);
            VerticalLayout {
                width: 100%;
                height: 100%;
                padding: root.page-padding;
                spacing: root.compact-window ? FluentMetrics.spacing-medium : FluentMetrics.spacing-large;

                VerticalLayout {
                    spacing: FluentMetrics.spacing-small;
                    Caption { text: "Fluent RS Gallery"; }
                    FluentText {
                        text: root.selected-destination >= 0 ? root.destinations[root.selected-destination].title : "";
                        font-size: FluentMetrics.title-size;
                        font-weight: FluentMetrics.strong-weight;
                        wrap: word-wrap;
                    }
                }

                FlexboxLayout {
                    spacing: root.compact-window ? FluentMetrics.spacing-small : FluentMetrics.spacing-medium;
                    alignment: start;
                    for option in [
                        { title: "Light", scheme: FluentColorScheme.light },
                        { title: "Dark", scheme: FluentColorScheme.dark },
                        { title: "High contrast", scheme: FluentColorScheme.high-contrast },
                    ] : Button {
                        text: option.title;
                        minimum-target: root.target-size;
                        variant: FluentTheme.scheme == option.scheme ? ButtonVariant.accent : ButtonVariant.standard;
                        accessible-description: FluentTheme.scheme == option.scheme ? "Selected theme" : "Apply theme";
                        clicked => { root.select-theme(option.scheme); }
                    }
                }

                pages := PageHost {
                    vertical-stretch: 1;
                    buttons := ButtonPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.button;
                        target-size: root.target-size;
                    }
                    text-boxes := TextBoxPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.text-box;
                        target-size: root.target-size;
                    }
                    toggles := TogglesPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.toggles;
                        target-size: root.target-size;
                        check-label: root.check-box-label;
                    }
                    radios := RadioPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.radios;
                        target-size: root.target-size;
                        max-columns: root.radio-max-columns;
                    }
                    ranges := RangePage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.ranges;
                        animations-enabled: self.visible && !root.minimized && root.range-animations-enabled;
                        target-size: root.target-size;
                    }
                    composition := CompositionPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.composition;
                        active: self.visible;
                        compact: pages.compact;
                        target-size: root.target-size;
                        items: root.composition-items;
                        viewport: root.safe-viewport;
                    }
                    combos := ComboBoxPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.combo-box;
                        active: self.visible;
                        target-size: root.target-size;
                        viewport: root.safe-viewport;
                        long-items: root.composition-items;
                        material-probe: root.combo-material-probe;
                    }
                    overlays := OverlaysPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.overlays;
                        active: self.visible;
                        viewport: root.safe-viewport;
                        target-size: root.target-size;
                        flyout-enabled: root.flyout-enabled;
                        menu-enabled: root.context-menu-enabled;
                        window-visible: !root.minimized;
                        tip-delay: root.tooltip-delay;
                        tip-duration: root.tooltip-duration;
                    }
                    dialogs := ContentDialogPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.content-dialog;
                        target-size: root.target-size;
                        viewport: root.safe-viewport;
                        primary-enabled: root.dialog-primary-enabled;
                        block-close: root.dialog-block-close;
                    }
                    navigation := NavigationViewPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.navigation-view;
                        active: self.visible;
                        viewport: root.safe-viewport;
                        target-size: root.target-size;

                    }

                    info-bars := InfoBarPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.info-bar;
                        target-size: root.target-size;
                        prevent-dismissal: root.info-bar-prevent-dismissal;
                    }
                    suggestions := AutoSuggestBoxPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.auto-suggest-box;
                        active: self.visible;
                        viewport: root.safe-viewport;
                        target-size: root.target-size;
                        filter(value) => { return root.filter-suggestions(value); }
                    }
                    trees := TreeViewPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.tree-view;
                        target-size: root.target-size;
                        load-large => { return root.load-large-tree(); }
                    }
                    commands := CommandBarPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.command-bar;
                        active: self.visible;
                        fixture-secondary: root.command-fixture;
                        fixture-backdrop: root.command-fixture-backdrop;
                        viewport: root.safe-viewport;
                        target-size: root.target-size;
                    }
                    passwords := PasswordBoxPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.password-box;
                        active: self.visible;
                        target-size: root.target-size;
                    }
                    switches := ToggleSwitchPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.toggle-switch;
                        active: self.visible;
                        target-size: root.target-size;
                    }
                    expanders := ExpanderPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.expander;
                        active: self.visible;
                        target-size: root.target-size;
                        viewport: root.safe-viewport;
                    }
                    split-buttons := SplitButtonPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.split-button;
                        active: self.visible;
                        target-size: root.target-size;
                        viewport: root.safe-viewport;
                    }
                    repeat-buttons := RepeatButtonPage {
                        width: 100%; height: 100%;
                        visible: root.page == GalleryPage.repeat-button;
                        active: self.visible;
                        target-size: root.target-size;
                        activated => { root.repeat-clicked(); }
                    }
                    hyperlinks := HyperlinkButtonPage {
                        width: 100%; height: 100%;
                        visible: root.page == GalleryPage.hyperlink-button;
                        active: self.visible;
                        target-size: root.target-size;
                        go-to-toggles => { root.page = GalleryPage.toggles; }
                    }
                    drop-down-buttons := DropDownButtonPage {
                        width: 100%; height: 100%;
                        visible: root.page == GalleryPage.drop-down-button;
                        active: self.visible;
                        target-size: root.target-size;
                        viewport: root.safe-viewport;
                    }
                    toggle-split-buttons := ToggleSplitButtonPage {
                        width: 100%; height: 100%;
                        visible: root.page == GalleryPage.toggle-split-button;
                        active: self.visible;
                        target-size: root.target-size;
                        viewport: root.safe-viewport;
                    }
                    grids := GridViewPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.grid-view;
                        active: self.visible;
                        target-size: root.target-size;
                        large-items: root.grid-fixture;
                    }
                    numbers := NumberBoxPage {
                        width:100%;height:100%;visible:root.page == GalleryPage.number-box;
                        active:self.visible;target-size:root.target-size;viewport:root.safe-viewport;
                    }
                    persons := PersonPicturePage {
                        width:100%;height:100%;visible:root.page == GalleryPage.person-picture;
                        target-size:root.target-size;
                    }
                    selectors := SelectorBarPage {
                        width: 100%; height: 100%;
                        visible: root.page == GalleryPage.selector-bar;
                        active: self.visible;
                        target-size: root.target-size;
                    }
                    pips := PipsPagerPage {
                        width: 100%; height: 100%;
                        visible: root.page == GalleryPage.pips-pager;
                        active: self.visible;
                        target-size: root.target-size;
                        viewport: root.safe-viewport;
                    }
                    foundations := FoundationsPage {
                        width: 100%;
                        height: 100%;
                        visible: root.page == GalleryPage.foundations;
                        target-size: root.target-size;
                        alternate-accent: root.alternate-accent;
                        backdrop: root.backdrop;
                        native-desktop-acrylic: root.native-desktop-acrylic;
                        change-appearance(action) => { root.change-appearance(action); }
                        select-backdrop(material) => { root.select-backdrop(material); }
                    }
                }
            }
        }
    }
}
