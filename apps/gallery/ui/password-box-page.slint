import { Button, ButtonVariant } from "../../../ui/button.slint";
import { OverlayArea } from "../../../ui/overlay-placement.slint";
import { PasswordBox, PasswordRevealMode } from "../../../ui/password-box.slint";
import { FluentText } from "../../../ui/primitives.slint";
import { FluentScrollView } from "../../../ui/scroll-view.slint";
import { FluentMetrics } from "../../../ui/tokens.slint";
import { TextBoxState } from "../../../ui/text-box.slint";

export struct PasswordProbe {
    bounds: OverlayArea, reveal: Point, focused: bool, revealed: bool,
    button-visible: bool, selection: bool, state: TextBoxState, scroll: length,
}

export component PasswordBoxPage inherits FluentScrollView {
    in property <bool> active;
    in property <length> target-size;
    in-out property <string> password <=> field.password;
    in-out property <bool> input-enabled: true;
    in-out property <PasswordRevealMode> reveal-mode;
    out property <int> edits;
    out property <int> submissions;
    out property <bool> following-focused: following.has-focus;
    out property <PasswordProbe> probe: {
        bounds: { x: field.input-position.x, y: field.input-position.y, width: field.input-width, height: field.input-height },
        reveal: field.reveal-center, focused: field.editor-focused, revealed: field.revealed,
        button-visible: field.reveal-button-visible, selection: field.has-selection, state: field.state,
        scroll: field.horizontal-scroll-offset,
    };
    public function select-input() { field.focus(); field.select-all(); }
    public function focus-input() { field.focus(); }
    public function leave-input() { following.focus(); }

    content-height: max(root.height, content.preferred-height);
    content := VerticalLayout {
        x: 0px;
        y: 0px;
        width: root.content-width;
        height: self.preferred-height;
        padding: FluentMetrics.spacing-medium;
        spacing: FluentMetrics.spacing-large;

        field := PasswordBox {
            header: "Password";
            placeholder-text: "Enter a password";
            active: root.active;
            enabled: root.input-enabled;
            minimum-target: root.target-size;
            reveal-mode: root.reveal-mode;
            password-changed => { root.edits += 1; }
            accepted => { root.submissions += 1; }
        }
        following := Button {
            text: "Submit";
            minimum-target: root.target-size;
            clicked => { root.submissions += 1; }
        }
        FlexboxLayout {
            spacing: FluentMetrics.spacing-medium;
            alignment: start;
            for choice in [
                { text: "Peek", mode: PasswordRevealMode.peek },
                { text: "Hidden", mode: PasswordRevealMode.hidden },
                { text: "Visible", mode: PasswordRevealMode.visible },
            ] : Button {
                text: choice.text;
                minimum-target: root.target-size;
                variant: root.reveal-mode == choice.mode ? ButtonVariant.accent : ButtonVariant.standard;
                clicked => { root.reveal-mode = choice.mode; }
            }
            Button {
                text: root.input-enabled ? "Disable input" : "Enable input";
                minimum-target: root.target-size;
                clicked => { root.input-enabled = !root.input-enabled; }
            }
        }
        FluentText { text: "Changes: " + root.edits + "   Submissions: " + root.submissions; wrap: word-wrap; }
        PasswordBox {
            header: "Pre-filled password";
            password: "Saved example";
            active: root.active;
            minimum-target: root.target-size;
        }
        PasswordBox {
            header: "Disabled";
            password: "Disabled example";
            enabled: false;
            active: root.active;
            minimum-target: root.target-size;
        }
    }
}
